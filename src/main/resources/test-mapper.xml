<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="test-mapper">
    <select id="findEmpById" resultType="com.ybx.mybatis.entity.Emp">
        select emp_id id, name, dept_id deptId from emp where emp_id=1
    </select>
</mapper>